# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # Settings → API → service_role key
SUPABASE_JWT_SECRET=your-jwt-secret       # Settings → API → JWT Secret
SUPABASE_ANON_KEY=eyJ...                  # Settings → API → anon key

# ── App ───────────────────────────────────────────────────────────────────────
DEFAULT_ORG_ID=                           # UUID of the default org for chatbot intake
ENVIRONMENT=development                   # development | staging | production
ALLOWED_ORIGINS=http://localhost:3000,https://brightwayz.io,https://api.wedkai.com

# ── AWS (for file uploads) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=brightwayz-uploads

# ── Optional: Google Maps (geocoding for resources) ────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Twilio (outbound SMS to clients; leave blank to disable) ──────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                       # E.164 format, e.g. +15551234567

# ── Resend (email notifications on case status changes) ───────────────────────
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=no-reply@brightwayz.io
